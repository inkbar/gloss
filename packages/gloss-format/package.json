{
  "name": "gloss-format",
  "version": "0.0.0",
  "description": "Gloss: a JSON format for PDF annotations. JSON Schema, types and constants.",
  "license": "MIT",
  "homepage": "https://gloss-format.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inkbar/gloss.git",
    "directory": "packages/gloss-format"
  },
  "bugs": "https://github.com/inkbar/gloss/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "schema.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./schema.json": "./schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --no-error-on-unmatched-pattern src scripts",
    "test": "vitest run",
    "generate": "tsx scripts/generate-schema.ts"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "prettier": "^3.9.0",
    "tsdown": "^0.23.1",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
