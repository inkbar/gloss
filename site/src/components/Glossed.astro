---
// A sample with its explanation in the margin, line for line, the way a gloss sits beside the
// text it explains. In a narrow column the notes move below the code, each naming its line. Keep
// notes short: in the margin they stay on one line.
interface Props {
  code: string
  // Keyed by line number, counting from 1.
  notes: Record<number, string>
  title?: string
}

const { code, notes, title } = Astro.props
const lines = code.replace(/\n$/, '').split('\n')
const entries = Object.entries(notes)
  .map(([line, text]) => ({ line: Number(line), text }))
  .sort((a, b) => a.line - b.line)

for (const { line } of entries) {
  if (!Number.isInteger(line) || line < 1 || line > lines.length) {
    throw new Error(`Glossed: no line ${line} in a ${lines.length}-line sample`)
  }
}
---

<figure class="glossed not-content" style={`--lines: ${lines.length}`}>
  {title && <figcaption>{title}</figcaption>}
  <div class="body">
    <pre><code>{lines.join('\n')}</code></pre>
    <ol class="notes">
      {entries.map(({ line, text }) => (
        <li style={`grid-row: ${line + 1}`}>
          <span class="ref">Line {line}</span>
          <span class="text">{text}</span>
        </li>
      ))}
    </ol>
  </div>
</figure>

<style>
  .glossed {
    --line: 1.9rem;
    container-type: inline-size;
    margin: 1.5rem 0;
    border-top: 1px solid var(--sl-color-gray-5);
    border-bottom: 1px solid var(--sl-color-gray-5);
  }
  figcaption {
    padding: 0.5rem 1.25rem;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    border-bottom: 1px solid var(--sl-color-gray-5);
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) max-content;
    /* A padding row above and below, so the code's padding keeps the notes on their lines. */
    grid-template-rows: 1.25rem repeat(var(--lines), var(--line)) 1.25rem;
  }
  pre {
    grid-column: 1;
    grid-row: 1 / -1;
    margin: 0;
    padding: 1.25rem;
    overflow-x: auto;
    background: var(--sl-color-gray-7);
    font-family: var(--sl-font-mono);
    font-size: 0.9rem;
    line-height: var(--line);
    color: var(--sl-color-white);
  }
  .notes {
    display: contents;
  }
  li {
    grid-column: 2;
    list-style: none;
    margin: 0;
    padding: 0 1.25rem;
    font-family: var(--gloss-font-note);
    font-style: italic;
    font-size: 0.95rem;
    line-height: var(--line);
    color: var(--sl-color-accent);
    white-space: nowrap;
  }
  li .text::before {
    content: '— ';
  }
  .ref {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @container (max-width: 36rem) {
    .body {
      display: block;
    }
    .notes {
      display: block;
      margin: 0;
      padding: 0.75rem 0 1rem;
      list-style: none;
    }
    li {
      padding: 0.15rem 1.25rem;
      line-height: 1.5;
      white-space: normal;
    }
    .ref {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
      margin-right: 0.5rem;
      font-family: var(--sl-font-mono);
      font-style: normal;
      font-size: var(--sl-text-xs);
      color: var(--sl-color-gray-3);
    }
    li .text::before {
      content: '';
    }
  }
</style>
